{
  "name": "bostonaholic-skills",
  "version": "0.66.0",
  "private": true,
  "description": "Matthew Boston's personal software engineering skills for coding agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bostonaholic/skills"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:repo": "node scripts/lint-repo.mjs",
    "lint:js": "tools/node_modules/.bin/oxlint --deny-warnings",
    "format": "tools/node_modules/.bin/oxfmt",
    "format:check": "tools/node_modules/.bin/oxfmt --check",
    "sync-shared": "node scripts/sync-shared.mjs",
    "readme": "node scripts/catalog.mjs --write",
    "eval": "node scripts/eval.mjs",
    "eval:handoff": "node scripts/eval-handoff.mjs",
    "site": "node scripts/build-site.mjs _site",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish"
  },
  "packageManager": "npm@10.9.4"
}

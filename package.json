{
  "name": "bostonaholic-skills",
  "version": "0.21.15",
  "private": true,
  "description": "Matthew Boston's personal software engineering skills for coding agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bostonaholic/skills"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:js": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "sync-shared": "node scripts/sync-shared.mjs",
    "readme": "node scripts/catalog.mjs --write",
    "eval": "node scripts/eval.mjs",
    "site": "node scripts/build-site.mjs _site",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "markdownlint-cli2": "0.23.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  }
}

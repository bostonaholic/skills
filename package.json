{
  "name": "bostonaholic-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Matthew Boston's agent skills for pull requests, code and design review, codebase audits, and investigation. Each skill installs on its own.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bostonaholic/skills"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "sync-shared": "node scripts/sync-shared.mjs",
    "readme": "node scripts/catalog.mjs --write",
    "site": "node scripts/build-site.mjs _site"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
